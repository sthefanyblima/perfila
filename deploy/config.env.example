# Copie para config.env (ignorado pelo git) e ajuste. O ambiente prevalece sobre o arquivo.
HTTP_PORT=8080
# Vazia = modo memória com dados sintéticos (D-23), só fora da implantação.
# Preenchida = PostgreSQL; o servidor aplica as migrações ao subir (Q-07, Q-09). Exemplo:
# DATABASE_URL=postgres://omega:SENHA@db:5432/omega_db?sslmode=disable
DATABASE_URL=
AUTH_TOKEN=troque-este-token
RECOMENDACAO_VALIDADE_DIAS=30
ENGAJAMENTO_META_EVENTOS=10
LOG_LEVEL=info
# Painel do operador (/painel, Spec 3.7.1). Hash e chave juntos; vazios = painel desligado (Q-29).
# scripts/preparar-implantacao.sh gera os três a partir de uma senha aleatória em deploy/.env.
PAINEL_USUARIO=operador
PAINEL_SENHA_HASH=
PAINEL_CHAVE_SESSAO=
PAINEL_FINALIDADE=segmentacao
PAINEL_VERSAO_TERMO=v1
# Portal do titular (/titular, Spec 3.7.2). Endereço e chave juntos; vazios = portal desligado (Q-60).
# O endereço é o público, o do Nginx (o link do e-mail aponta para ele); a chave é diferente da do painel.
# scripts/preparar-implantacao.sh preenche os dois.
PORTAL_URL_BASE=
PORTAL_CHAVE_SESSAO=
